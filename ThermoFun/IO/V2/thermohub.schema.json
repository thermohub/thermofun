       }
      },
      {
       "type": "array",
       "items": {
        "$ref": "#/$defs/reaction"
       }
      }
     ]
    },
    "methods": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/method_definition"
       }
      },
      {
       "type": "array",
       "items": {
        "$ref": "#/$defs/method_definition"
       }
      }
     ]
    },
    "parameter_sets": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/parameter_set"
       }
      },
      {
       "type": "array",
       "items": {
        "$ref": "#/$defs/parameter_set"
       }
      }
     ]
    },
    "data_sources": {
     "oneOf": [
