   "patternProperties": {
    "^_": {}
   },
   "additionalProperties": false
  },
  "single_record": {
   "description": "A file of one record: its record_type, and the record without thermohub.",
   "oneOf": [
    {
     "allOf": [
      {
       "required": [
        "record_type"
       ],
       "properties": {
        "record_type": {
         "const": "element"
        }
       }
      },
      {
       "$ref": "#/$defs/element"
      }
     ]
    },
    {
     "allOf": [
      {
       "required": [
        "record_type"
       ],
       "properties": {
        "record_type": {
         "const": "substance"
        }
       }
      },
      {
       "$ref": "#/$defs/substance"
      }
     ]
    },
    {
     "allOf": [
      {
       "required": [
        "record_type"
       ],
       "properties": {
        "record_type": {
         "const": "reaction"
        }
       }
      },
      {
       "$ref": "#/$defs/reaction"
      }
     ]
    },
    {
     "allOf": [
      {
       "required": [
        "record_type"
       ],
       "properties": {
        "record_type": {
         "const": "method"
        }
       }
